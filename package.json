{
  "name": "threesmith",
  "version": "0.3.0",
  "mcpName": "io.github.laaielichter/threesmith",
  "description": "MCP server and CLI that makes coding agents better at three.js: the API of your installed three version, a scored review pinned to it (98 rules incl. shaders and R3F), asset and decoder checks, the page run headless with the live scene read back, play with claims, perf and leak checks, build checks, and 3D models built without Blender.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "threesmith": "dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "plugins/threesmith/skills",
    "PRIVACY.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "version": "node scripts/sync-version.mjs && git add server.json plugins/threesmith gemini-extension.json",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "plugin:local": "node scripts/plugin-local.mjs",
    "build:site": "npm run build && node scripts/build-site.mjs"
  },
  "keywords": [
    "threejs",
    "three.js",
    "webgl",
    "webgpu",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "codex",
    "ai-agent",
    "coding-agent",
    "linter",
    "code-review",
    "screenshot",
    "headless",
    "github-action",
    "ci",
    "cli",
    "agent-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laaielichter/Threesmith.git"
  },
  "homepage": "https://laaielichter.github.io/Threesmith/",
  "bugs": {
    "url": "https://github.com/laaielichter/Threesmith/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.65.0",
    "rolldown": "1.3.0",
    "three": "0.187.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

{
  "release": 128,
  "guide": "https://github.com/mrdoob/three.js/wiki/Migration-Guide#127--128",
  "entries": [
    {
      "id": "es6-classes",
      "kind": "behaviour",
      "title": "Core classes are ES6 classes: ES5 inheritance breaks",
      "detect": {
        "pattern": "\\b(?:[\\w$]+\\.)?(?:Object3D|Mesh|BufferGeometry|ShaderMaterial|Material|Group)\\.call\\s*\\(\\s*this\\b|Object\\.create\\s*\\(\\s*(?:[\\w$]+\\.)?(?:Object3D|Mesh|BufferGeometry|Material|Group)\\.prototype"
      },
      "todo": "Use class X extends THREE.Mesh { constructor() { super(); } }.",
      "source": "https://github.com/mrdoob/three.js/wiki/Migration-Guide#127--128"
    }
  ]
}

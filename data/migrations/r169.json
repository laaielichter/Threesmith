      "kind": "behaviour",
      "title": "EXRExporter.parse(), KTX2Exporter.parse() and LightProbeGenerator.fromCubeRenderTarget() are async",
      "detect": {
        "pattern": "\\b(?:EXRExporter|KTX2Exporter)\\b|\\bfromCubeRenderTarget\\s*\\("
      },
      "todo": "await the result.",

{
  "release": 171,
  "guide": "https://github.com/mrdoob/three.js/wiki/Migration-Guide#170--171",
  "entries": [
    {
      "id": "webgpu-import-paths",
      "kind": "rename",
      "title": "WebGPURenderer and TSL import from three/webgpu and three/tsl",
      "detect": {
        "pattern": "['\\\"]three/(?:examples/jsm|addons)/(?:nodes|renderers/webgpu)/|['\\\"]three/nodes['\\\"]",
        "rules": [
          "tsl-import-path"
        ]
      },
      "todo": "import { WebGPURenderer, MeshStandardNodeMaterial } from 'three/webgpu'; import { color, uv } from 'three/tsl';",
      "source": "https://github.com/mrdoob/three.js/wiki/Migration-Guide#170--171"
    },
    {
      "id": "tsl-blend-renamed",
      "kind": "rename",
      "title": "TSL burn(), dodge(), screen() and overlay() are blendBurn() ... blendOverlay()",
      "detect": {
        "pattern": "(?<![\\w$.])(?:burn|dodge|screen|overlay)\\s*\\(",
        "also": "three/(?:tsl|webgpu)"
      },
      "todo": "Rename them.",
      "source": "https://github.com/mrdoob/three.js/wiki/Migration-Guide#170--171"
    },
    {
      "id": "tsl-storage-object",
      "kind": "rename",
      "title": "storageObject() is deprecated",
      "detect": {
        "pattern": "\\bstorageObject\\s*\\("
      },
      "todo": "storage( ... ).setPBO( true ).",
      "source": "https://github.com/mrdoob/three.js/wiki/Migration-Guide#170--171"
    }
  ]
}
